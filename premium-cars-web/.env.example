# Salin ke .env.local (lokal) atau set di Environment Variables Vercel.
# Semua opsional — tanpa key, situs jalan memakai data kurasi lokal.

# URL produksi situs (dipakai untuk metadata OG, sitemap.xml, robots.txt).
# Contoh: https://premium-cars-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Backend leads (/api/leads) ──────────────────────────────────────────
# Tanpa variabel di bawah, lead tetap divalidasi + disimpan ke
# data/leads.json (lokal) / /tmp (Vercel, ephemeral) + tercatat di log.
# Webhook menerima POST JSON tiap ada lead — tempel URL Slack/Discord/Zapier.
LEADS_WEBHOOK_URL=
# Kirim email notifikasi lead via Resend (https://resend.com)
RESEND_API_KEY=
LEADS_EMAIL_TO=
LEADS_EMAIL_FROM=
# Token untuk membaca lead tersimpan: GET /api/leads (Bearer token)
ADMIN_TOKEN=

# ── Auth (login/daftar) ────────────────────────────────────────────────
# Rahasia penandatangan cookie sesi — WAJIB di-set di produksi
# (string acak panjang, mis. hasil `openssl rand -hex 32`).
AUTH_SECRET=

# Listing marketplace realtime (harga, foto, mileage) — MarketCheck
# https://www.marketcheck.com/apis
MARKETCHECK_API_KEY=

# Spesifikasi teknis live untuk fitur "Cek Spesifikasi" — API Ninjas /v1/cars
# https://api-ninjas.com/api/cars
API_NINJAS_KEY=

# Reference makes/models/trims (opsional, belum dipakai UI) — CarAPI
# https://carapi.app
CARAPI_TOKEN=
CARAPI_SECRET=

# ── Market Intelligence (/harga-pasar) ─────────────────────────────────
# Katalog merek/model memakai NHTSA vPIC — GRATIS, tanpa key.
# Kurs memakai frankfurter.app — GRATIS, tanpa key.
# TANPA key apa pun, harga internasional tetap LIVE via Tabela FIPE (Brasil).
# Untuk listing aktif pasar AS (jumlah unit + harga real-time), urutan:
#   1. Auto.dev (https://auto.dev — daftar gratis, salin API key):
AUTODEV_API_KEY=
#   2. MARKETCHECK_API_KEY di bagian atas file ini.
# Faktor estimasi harga nasional = median USD × kurs × faktor ini
# (perkiraan bea masuk + PPnBM + PPN unit CBU). Default 2.4.
NATIONAL_PRICE_FACTOR=
